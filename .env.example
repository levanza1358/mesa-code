# =============================================================================
# Mesa Code environment template
# =============================================================================
#
# How to use this file
# --------------------
# 1. Copy this file to `.env` (or `.env.local` for a local-only override that is
#    never committed).
# 2. Fill only the sections you need. Every variable is optional: a missing
#    value falls back to the default baked into the build, so an empty file
#    never blocks startup.
# 3. Never commit a real secret. `.env`, `.env.local`, and `.env.*.local` are
#    already ignored by Git.
#
# The only setting most people need is GitHub login. Without it, the login
# screen hides the GitHub button instead of showing a button that cannot work.
# See "GitHub login" below.
# =============================================================================


# -----------------------------------------------------------------------------
# Service endpoints (optional)
# -----------------------------------------------------------------------------
# Public online endpoints. These are the values the app uses when the variable
# is absent, so you normally do not need to touch this section. Override only
# when you point the app at a staging or private deployment.
MESA_ENDPOINT_ORIGIN=https://mesa-code.z.ai
MESA_OAUTH_ORIGIN=https://chat.z.ai
MESA_BUSINESS_API_ORIGIN=https://api.z.ai
MESA_CDN_ORIGIN=https://cdn-mesa-code.z.ai
MESA_BIGMODEL_API_ORIGIN=https://bigmodel.cn

# Public OAuth client id for the managed login. This is a public value, not a
# secret.
MESA_OAUTH_CLIENT_ID=client_P8X5CMWmlaRO9gyO-KSqtg


# -----------------------------------------------------------------------------
# GitHub login (optional, but needed for GitHub sign-in and Git push)
# -----------------------------------------------------------------------------
# Steps:
#   1. Open https://github.com/settings/developers, then
#      "OAuth Apps" -> "New OAuth App".
#   2. Set "Authorization callback URL" to EXACTLY:
#          http://localhost:8123/callback
#   3. Copy the Client ID into GITHUB_OAUTH_CLIENT_ID.
#   4. Generate a client secret and copy it into GITHUB_OAUTH_CLIENT_SECRET.
#      The secret is shown only once.
#   5. Restart Mesa Code.
#
# The desktop app serves that localhost address itself and binds it to loopback
# only. Do not change the port unless you also change the callback URL that is
# registered on GitHub.
#
# Leave both values empty to hide GitHub login entirely.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Only change this when you registered a different callback URL on GitHub.
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8123/callback
# Set to 0 to disable GitHub login without deleting the credentials.
GITHUB_OAUTH_ENABLED=1


# -----------------------------------------------------------------------------
# Conversation sharing and remote assets (optional)
# -----------------------------------------------------------------------------
# Link base used when importing a shared conversation. Keep the `/cn/share`
# suffix, and do not set an empty value. Remove the line to follow the API
# origin instead.
MESA_CONVERSATION_SHARE_URL=https://mesa-code.z.ai/cn/share
# Full remote asset base URL. It must include the version that matches this
# build. Remove the line to derive the URL from the running version.
MESA_REMOTE_ASSET_BASE_URL=https://cdn-mesa-code.z.ai/mesa-code/electron/releases/3.14.0


# -----------------------------------------------------------------------------
# Local provider configuration (optional)
# -----------------------------------------------------------------------------
# Path to a local provider config file. Leave empty to use the built-in online
# configuration.
MESA_PROVIDER_CONFIG_FILE=


# -----------------------------------------------------------------------------
# Intranet / private deployment (optional)
# -----------------------------------------------------------------------------
# These have no public default. Fill them in only for an intranet deployment.
# The mirror host and the dependency base URL feed internal package downloads.
MESA_INTRANET_HOST=
MESA_DEPS_BASE_URL=
